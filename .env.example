# 服务端口
PORT=3000

# 平台抽成（每单平台分账金额，单位：元）
PLATFORM_FEE=0.3

# 帮取人佣金（每单帮取人到账金额，单位：元）
PICKER_FEE=1.2

# 顾客支付金额（每单总额，单位：元）
ORDER_AMOUNT=1.5

# 履约保证金（单位：元）
DEPOSIT_AMOUNT=50

# 王者帮取人保证金减免金额
DEPOSIT_DISCOUNT_AMOUNT=25

# 待接单超时时间（单位：毫秒，默认 10 分钟）
PENDING_MATCH_TIMEOUT=600000

# 待确认收货超时时间（单位：毫秒，默认 24 小时）
PENDING_CONFIRM_TIMEOUT=86400000
